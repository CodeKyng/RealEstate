# Copy to .env and fill from Firebase Console → Project settings → Your apps
# Do NOT commit real values. Firebase web config is public at runtime but keep it out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
